<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DoinkBinds.Views.StatusIndicatorWindow"
        Title="Doink Binds status"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <!-- Small always-on-top pill shown while recording / playing. ShowActivated=False so it never steals focus. -->
    <Border Background="#F01E1F22" CornerRadius="999" Padding="14,7" Margin="6"
            BorderBrush="#3F4147" BorderThickness="1" BoxShadow="0 4 14 0 #66000000">
        <StackPanel Orientation="Horizontal" Spacing="9">
            <Ellipse x:Name="Dot" Classes="dot" Width="10" Height="10" VerticalAlignment="Center" />
            <TextBlock x:Name="Label" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
