<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DoinkBinds.Views.NotificationWindow"
        Title="Doink Binds notification"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="Height"
        Width="340"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
    <!-- Floating notification (Notify steps, rules). Never steals focus; click to dismiss. -->
    <Border x:Name="Card" Background="#F21E1F22" CornerRadius="12" Padding="14,12" Margin="8"
            BorderBrush="#5865F2" BorderThickness="1" BoxShadow="0 6 20 0 #80000000" Cursor="Hand">
        <Grid ColumnDefinitions="Auto,*">
            <Border Width="30" Height="30" CornerRadius="8" Background="#335865F2" VerticalAlignment="Top">
                <PathIcon x:Name="Icon" Data="{StaticResource Icon.Lightning}" Width="15" Height="15" Foreground="#949CF7" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                <TextBlock x:Name="TitleText" Foreground="#B5BAC1" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MessageText" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxHeight="120" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
