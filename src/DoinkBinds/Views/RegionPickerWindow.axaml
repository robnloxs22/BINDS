<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DoinkBinds.Views.RegionPickerWindow"
        Title="Doink Binds — Select on screen"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="#01000000"
        Cursor="Cross">
    <!--
        Snipping-tool style picker. A frozen screenshot of this monitor is shown as the background
        (when screen capture is available) so the picked area is exactly what was on screen.
        Region mode: drag a box. Colour mode: click a pixel (magnifier shows the pixels under the cursor).
    -->
    <Panel>
        <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapInterpolationMode="LowQuality" />
        <Canvas x:Name="Surface" Background="Transparent">
            <!-- Dim everything outside the selection with four rectangles -->
            <Rectangle x:Name="DimTop" Fill="#70000000" />
            <Rectangle x:Name="DimBottom" Fill="#70000000" />
            <Rectangle x:Name="DimLeft" Fill="#70000000" />
            <Rectangle x:Name="DimRight" Fill="#70000000" />
            <Border x:Name="Selection" BorderBrush="#5865F2" BorderThickness="2" IsVisible="False" />
            <Border x:Name="SizeBadge" Background="#E61E1F22" CornerRadius="6" Padding="8,3" IsVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
            </Border>

            <Border x:Name="Magnifier" Background="#F21E1F22" CornerRadius="10" Padding="6" IsVisible="False"
                    BorderBrush="#5865F2" BorderThickness="1">
                <StackPanel Spacing="6">
                    <Panel Width="132" Height="132">
                        <Image x:Name="Zoom" Width="132" Height="132" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                        <Border Width="12" Height="12" BorderBrush="White" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="Swatch" Width="18" Height="18" CornerRadius="4" BorderBrush="White" BorderThickness="1" />
                        <TextBlock x:Name="HexText" Foreground="White" FontSize="13" VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="Hint" Background="#F21E1F22" CornerRadius="10" Padding="16,10" BorderBrush="#3F4147" BorderThickness="1"
                    Canvas.Top="24">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="HintText" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="HintSub" Foreground="#B5BAC1" FontSize="12" />
                </StackPanel>
            </Border>
        </Canvas>
    </Panel>
</Window>
