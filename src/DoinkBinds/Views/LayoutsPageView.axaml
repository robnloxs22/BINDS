<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DoinkBinds.ViewModels"
             x:Class="DoinkBinds.Views.LayoutsPageView"
             x:DataType="vm:LayoutsPageViewModel">
    <Panel Margin="24,18,24,20">
        <StackPanel IsVisible="{Binding !HasSelection}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="460">
            <PathIcon Data="{StaticResource Icon.Window}" Width="40" Height="40" Foreground="#00A8FC" />
            <TextBlock Classes="h1" TextAlignment="Center" Text="Window layouts" />
            <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Arrange your apps the way you like, save it, and restore it any time with one click or a hotkey. Apps that aren't running can be started automatically." />
            <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding NewLayoutCommand}">
                <TextBlock Text="Save the current windows as a layout" Foreground="White" />
            </Button>
        </StackPanel>

        <Panel IsVisible="{Binding HasSelection}">
        <Grid RowDefinitions="Auto,Auto,*" DataContext="{Binding Selected}" x:DataType="vm:LayoutViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Spacing="2">
                    <TextBox Classes="title" Text="{Binding Name}" Margin="-6,0,0,0" HorizontalAlignment="Left" MinWidth="220" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="caption" Text="{Binding Summary}" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="· Hotkey:" VerticalAlignment="Center" />
                        <Button Classes="ghost" Padding="6,0" Height="20" FontSize="12" Content="{Binding HotkeyText}" Command="{Binding CaptureHotkeyCommand}" />
                        <Button Classes="ghost" Padding="4,0" Height="20" FontSize="11" Content="clear" Command="{Binding ClearHotkeyCommand}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Button Classes="success" Command="{Binding ApplyCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Play}" Width="13" Height="13" />
                            <TextBlock Text="Apply now" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button Content="Add window" Command="{Binding AddWindowCommand}" />
                    <Button Content="Re-capture all" Command="{Binding RecaptureCommand}" />
                    <Button Classes="ghost icon" ToolTip.Tip="Delete layout" Command="{Binding DeleteCommand}">
                        <PathIcon Data="{StaticResource Icon.Delete}" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <TextBlock Classes="section" Text="WAIT FOR STARTED APPS (S)" VerticalAlignment="Center" />
                <NumericUpDown Classes="compact" Value="{Binding LaunchWaitSeconds}" Minimum="1" Maximum="300" FormatString="0" Width="72" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="Also usable from macros: Window action → Apply a saved layout." />
            </StackPanel>

            <ScrollViewer Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Entries}" Margin="0,0,10,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LayoutEntryViewModel">
                            <Border Classes="card" Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="caption" Text="APP (PROCESS NAME)" />
                                            <TextBox Text="{Binding ProcessName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Classes="caption" Text="TITLE CONTAINS (OPTIONAL)" />
                                            <TextBox Text="{Binding TitleContains}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,14,0,0">
                                        <Button Classes="ghost" Padding="8,4" FontSize="12" Content="Use current position" Command="{Binding UseCurrentPositionCommand}" />
                                        <Button Classes="ghost icon" ToolTip.Tip="Remove from layout" Command="{Binding RemoveCommand}">
                                            <PathIcon Data="{StaticResource Icon.Close}" Width="11" Height="11" />
                                        </Button>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,6,*,6,*,6,*,6,140" Margin="0,0,0,8">
                                        <StackPanel Spacing="2"><TextBlock Classes="caption" Text="X" /><NumericUpDown Value="{Binding X}" Minimum="-100000" Maximum="100000" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2"><TextBlock Classes="caption" Text="Y" /><NumericUpDown Value="{Binding Y}" Minimum="-100000" Maximum="100000" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
                                        <StackPanel Grid.Column="4" Spacing="2"><TextBlock Classes="caption" Text="WIDTH" /><NumericUpDown Value="{Binding Width}" Minimum="50" Maximum="100000" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
                                        <StackPanel Grid.Column="6" Spacing="2"><TextBlock Classes="caption" Text="HEIGHT" /><NumericUpDown Value="{Binding Height}" Minimum="50" Maximum="100000" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
                                        <StackPanel Grid.Column="8" Spacing="2">
                                            <TextBlock Classes="caption" Text="STATE" />
                                            <ComboBox ItemsSource="{x:Static vm:Options.WindowStates}" SelectedItem="{Binding State}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                        <TextBox Text="{Binding LaunchCommand}" Watermark="If it isn't running, start: (app path / command / URL — optional)" />
                                        <Button Grid.Column="1" Classes="ghost icon" Margin="4,0,0,0" ToolTip.Tip="Browse…" Command="{Binding BrowseLaunchCommand}">
                                            <PathIcon Data="{StaticResource Icon.FolderOpen}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        </Panel>
    </Panel>
</UserControl>
