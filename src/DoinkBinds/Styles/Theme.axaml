<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource Doink.Bg.Main}">
            <StackPanel Spacing="8">
                <Button Classes="primary" Content="Primary" />
                <Button Classes="danger" Content="Danger" />
                <Button Classes="ghost" Content="Ghost" />
                <TextBlock Classes="h1" Text="Heading" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- ===================== Base ===================== -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Main}" />
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text}" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text.Muted}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text.Muted}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text.Secondary}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text.Muted}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
    </Style>

    <!-- ===================== Cards ===================== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Doink.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Doink.Radius.Large}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ===================== Buttons ===================== -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{StaticResource Doink.Radius}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Raised}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource Doink.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Doink.Accent.Hover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource Doink.Red}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Doink.Red.Hover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.success">
        <Setter Property="Background" Value="{StaticResource Doink.Green}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Doink.Green.Hover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text.Secondary}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="7" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- Big round transport buttons (Record / Play / Stop) -->
    <Style Selector="Button.transport">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.transport PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- ===================== Inputs ===================== -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource Doink.Radius}" />
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Doink.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Doink.Text}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Doink.Border}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Doink.Accent}" />
    </Style>

    <!-- Inline title editor that looks like a heading until focused -->
    <Style Selector="TextBox.title">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="TextBox.title:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Hover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource Doink.Radius}" />
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Doink.Border.Subtle}" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="{StaticResource Doink.Radius}" />
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Doink.Border.Subtle}" />
    </Style>

    <!-- ===================== Lists ===================== -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Hover}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Selected}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Selected}" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Hover}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Selected}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Selected}" />
    </Style>

    <!-- ===================== Status pill ===================== -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Raised}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.pill.recording">
        <Setter Property="Background" Value="{StaticResource Doink.Red.Soft}" />
    </Style>
    <Style Selector="Border.pill.playing">
        <Setter Property="Background" Value="{StaticResource Doink.Green.Soft}" />
    </Style>
    <Style Selector="Border.pill.paused">
        <Setter Property="Background" Value="{StaticResource Doink.Yellow.Soft}" />
    </Style>

    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource Doink.Text.Muted}" />
    </Style>
    <Style Selector="Ellipse.dot.recording">
        <Setter Property="Fill" Value="{StaticResource Doink.Red}" />
        <Style.Animations>
            <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.25" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Ellipse.dot.playing">
        <Setter Property="Fill" Value="{StaticResource Doink.Green}" />
    </Style>
    <Style Selector="Ellipse.dot.paused">
        <Setter Property="Fill" Value="{StaticResource Doink.Yellow}" />
    </Style>

    <!-- Step type badge in the timeline -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{StaticResource Doink.Accent.Soft}" />
    </Style>
    <Style Selector="Border.badge.key">
        <Setter Property="Background" Value="{StaticResource Doink.Green.Soft}" />
    </Style>
    <Style Selector="Border.badge.wait">
        <Setter Property="Background" Value="{StaticResource Doink.Yellow.Soft}" />
    </Style>

    <!-- Playback cursor highlight in the timeline -->
    <Style Selector="Border.step">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.step.current">
        <Setter Property="BorderBrush" Value="{StaticResource Doink.Green}" />
        <Setter Property="Background" Value="{StaticResource Doink.Green.Soft}" />
    </Style>

    <!-- Toast -->
    <Style Selector="Border.toast">
        <Setter Property="CornerRadius" Value="{StaticResource Doink.Radius}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Background" Value="{DynamicResource Doink.Bg.Deep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Doink.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
    </Style>
    <Style Selector="Border.toast.error">
        <Setter Property="BorderBrush" Value="{StaticResource Doink.Red}" />
    </Style>
    <Style Selector="Border.toast.success">
        <Setter Property="BorderBrush" Value="{StaticResource Doink.Green}" />
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource Doink.Border.Subtle}" />
    </Style>
</Styles>
